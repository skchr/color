{
  "entryPoints": [
    "./lib/accessibility/*",
    "./lib/generators/*",
    "./lib/palettes/*",
    "./lib/wrappers/*",
    "./lib/utils/*",
    "./lib/collection/*",
    "./lib/types.d.ts"
  ],
  "entryPointStrategy": "resolve",
  "out": "./site",
  "plugin": ["typedoc-material-theme"],
  "themeColor": "#a7c7e7",
  "projectDocuments": ["docs/**/*.md"],
  "cleanOutputDir": true,
  "skipErrorChecking": true,
  "exclude": ["./lib/internal"],
  "excludeNotDocumented": true,
  "hideGenerator": true,
  "githubPages": true
}
